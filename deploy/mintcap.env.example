# mintcap 비밀/환경 설정 -- 실제 값 버전은 Arduino Q 의
#   ~/.config/mintcap/mintcap.env  (chmod 600, git 에 절대 커밋 안 함)
# 에만 둔다. 이 파일은 템플릿이므로 커밋됨.
#
# 설치:
#   mkdir -p ~/.config/mintcap
#   cp deploy/mintcap.env.example ~/.config/mintcap/mintcap.env
#   chmod 600 ~/.config/mintcap/mintcap.env
#   nano ~/.config/mintcap/mintcap.env   # 값 채우기

# HiveMQ Cloud (hub.py 가 구독할 MQTT 브로커)
MQTT_BROKER=xxxxxxxxxxxxxxxxxxxxxxxx.s1.eu.hivemq.cloud
MQTT_PORT=8883
MQTT_USERNAME=your-mqtt-username
MQTT_PASSWORD=your-mqtt-password
