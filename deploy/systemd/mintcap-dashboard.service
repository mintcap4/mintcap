[Unit]
Description=mintcap Sensor Dashboard (Streamlit)
After=network-online.target mintcap-hub.service

[Service]
Type=simple
WorkingDirectory=%h/mintcap
ExecStart=%h/mintcap/.venv/bin/streamlit run %h/mintcap/dashboard.py --server.address 0.0.0.0 --server.port 8501 --server.headless true
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
